# GAWAZ INN 2.0 Environment Configuration (Copy to .env for local full-stack runs)
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
DB_DRIVER=sqlite
SQLITE_PATH=.data/gawazinn.db

# Optional PostgreSQL / Supabase connection for production Vercel / cloud deployments
DATABASE_URL=

# Auth session cookie signing secret (replace with strong random string in production)
SESSION_SECRET=gawazinn-dev-local-secret-change-in-production

# Public web origin
APP_ORIGIN=http://localhost:3000

# Optional official WhatsApp number without + (leave blank/demo until finalized)
VITE_SUPPORT_WHATSAPP=201000000000

# Optional External Integration Keys (Disabled safely until provided)
AI_PROVIDER_API_KEY=
PAYMOB_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
STORAGE_BUCKET=


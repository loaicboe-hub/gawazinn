{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/sitemap.xml", "destination": "/api/index" },
    { "source": "/((?!assets/|robots\\.txt|sitemap\\.xml|intro-proposal\\.jpg).*)", "destination": "/index.html" }
  ]
}

